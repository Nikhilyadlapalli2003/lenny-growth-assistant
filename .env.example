# ---------- Database ----------
# Local docker-compose default. For Supabase/Railway, paste their connection string here.
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant

# ---------- LLM provider toggle (required) ----------
# "ollama" = local model (mandatory for the eval demo), "anthropic" = cloud
DEFAULT_LLM_PROVIDER=ollama
ALLOW_PROVIDER_OVERRIDE_VIA_HEADER=true

# ---------- Ollama (local, required) ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# ---------- Anthropic (cloud, optional) ----------
# Leave blank to run local-only. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Embeddings ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=100

# ---------- App ----------
ENV=local
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
